# ─── DATABASE ─────────────────────────────────────────────────────
# Get connection string from: Supabase Dashboard → Project Settings → Database
# Direct connection (requires IP allowlist):
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Transaction pooler (no allowlist needed):
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Find your region in: Supabase Dashboard → Project Settings → Database → Connection Pooling
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=change-this-in-production-use-openssl-rand-hex-32  # Generate: openssl rand -hex 32
JWT_ISSUER=sports-analysis-app
JWT_AUDIENCE=sports-analysis-app
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Access Control (comma-separated emails — auto-promoted on first login)
ADMIN_EMAILS=ikambili34@gmail.com,ikambili34@live.com

# Google OAuth (for /api/v1/auth/google endpoint)
GOOGLE_CLIENT_ID=

# Local HDD Storage (GDPR: 90-day retention)
STORAGE_PATH=/mnt/data/videos
RETENTION_DAYS=90

# Payment Providers (managed via Doppler in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://sports-analysis-app.onrender.com/payments/success
STRIPE_CANCEL_URL=https://sports-analysis-app.onrender.com/payments/cancel
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://sports-analysis-app.onrender.com/api/v1/payments/mpesa/callback
SERVER_BASE_URL=https://sports-analysis-app.onrender.com

# Server
HOST=0.0.0.0
PORT=8000
